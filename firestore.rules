rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if the current user is an admin
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Function to check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }
    
    // Function to check if user owns the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Admins Collection
    match /admins/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false; // Only manageable via Firebase Console or Admin SDK
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
    }

    // Leaders Collection
    match /leaders/{leaderId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Topics Collection
    match /topics/{topicId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // App Config Collection
    match /appConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Elections Collections
    match /elections_metadata/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /elections_constituencies/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Posts Collection
    match /posts/{postId} {
      allow read: if resource.data.isApproved == true || isAdmin() || (isAuth() && resource.data.authorId == request.auth.uid);
      allow create: if isAuth() && 
                    request.resource.data.content.size() <= 500 &&
                    request.resource.data.authorId == request.auth.uid &&
                    (!('isApproved' in request.resource.data) || request.resource.data.isApproved == false || isAdmin());
      allow update: if isAdmin() || (isAuth() && resource.data.authorId == request.auth.uid && 
                    (!('isApproved' in request.resource.data) || request.resource.data.isApproved == resource.data.isApproved));
      allow delete: if isAdmin() || (isAuth() && resource.data.authorId == request.auth.uid);

      // Post Comments Subcollection
      match /comments/{commentId} {
        allow read: if resource.data.isApproved == true || isAdmin() || (isAuth() && resource.data.authorId == request.auth.uid);
        allow create: if isAuth() && 
                      request.resource.data.authorId == request.auth.uid &&
                      (
                        (request.resource.data.isReply == true && request.resource.data.content.size() <= 50) ||
                        ((!('isReply' in request.resource.data) || request.resource.data.isReply == false) && request.resource.data.content.size() <= 500)
                      ) &&
                      (!('isApproved' in request.resource.data) || request.resource.data.isApproved == false || isAdmin());
        allow update: if isAdmin() || (isAuth() && resource.data.authorId == request.auth.uid && 
                      (!('isApproved' in request.resource.data) || request.resource.data.isApproved == resource.data.isApproved));
        allow delete: if isAdmin() || (isAuth() && resource.data.authorId == request.auth.uid);
      }
    }

    // Reactions Collection
    // Document IDs must follow pattern: {userId}_{entityId}_{type} or similar
    // We enforce that the reaction belongs to the auth user
    match /reactions/{reactionId} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // Polls Collection
    match /polls/{pollId} {
      allow read: if true;
      allow create: if isAuth() && 
                    request.resource.data.creatorId == request.auth.uid &&
                    (!('isFeatured' in request.resource.data) || request.resource.data.isFeatured == false || isAdmin()) &&
                    (!('isElectionPoll' in request.resource.data) || request.resource.data.isElectionPoll == false || isAdmin());
      allow update: if isAdmin() || (isAuth() && resource.data.creatorId == request.auth.uid && 
                    (!('isFeatured' in request.resource.data) || request.resource.data.isFeatured == resource.data.isFeatured) &&
                    (!('isElectionPoll' in request.resource.data) || request.resource.data.isElectionPoll == resource.data.isElectionPoll));
      allow delete: if isAdmin() || (isAuth() && resource.data.creatorId == request.auth.uid);

      // Poll Votes Subcollection
      match /votes/{userId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isAuth() && isOwner(userId) && request.resource.data.userId == request.auth.uid;
        allow update: if isAuth() && isOwner(userId) && request.resource.data.userId == request.auth.uid;
        allow delete: if false;
      }
    }
  }
}
